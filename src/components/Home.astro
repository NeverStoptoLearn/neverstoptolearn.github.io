---
import type { Locale } from '../data/types';
import { profile } from '../data/profile';
import { href, labels } from '../lib/i18n';
import Education from './Education.astro';
import Records from './Records.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const en = locale === 'en';
---
<div class="page-width home">
  <header class="profile-intro">
    <h1>{profile.name}</h1>
    <p class="profile-role">{profile.role[locale]}</p>
    <p class="profile-affiliation">{profile.affiliation[locale]}</p>
    <div class="profile-links">
      <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={href(locale, 'cv')}>{labels[locale].cv}</a>
      <a href={href(locale, 'contact')}>{labels[locale].contact}</a>
    </div>
  </header>
  <p class="profile-biography">{profile.biography[locale]}</p>
  <Education locale={locale} />
  <section class="home-section" id="publications">
    <h2>{labels[locale].publications}</h2>
    <Records locale={locale} kind="publications" headingLevel={3} />
  </section>
  <section class="home-section">
    <h2>{labels[locale].research}</h2>
    {profile.researchAreas.length ? <ul>{profile.researchAreas.map(area => <li><strong>{area.title[locale]}</strong><p>{area.description[locale]}</p></li>)}</ul> : <p class="muted">{en ? 'Research interests will be added here.' : '研究方向待补充。'}</p>}
    <a href={href(locale, 'research')}>{en ? 'More about my research' : '查看研究方向'}</a>
  </section>
  <section class="home-section">
    <div class="section-heading"><h2>{labels[locale].projects}</h2><a href={href(locale, 'projects')}>{en ? 'All projects' : '全部项目'}</a></div>
    <Records locale={locale} kind="projects" selected />
  </section>
</div>
