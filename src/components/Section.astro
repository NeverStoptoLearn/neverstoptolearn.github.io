---
import type { Locale } from '../data/types';
import { profile } from '../data/profile';
import { href, labels, type Section } from '../lib/i18n';
import Education from './Education.astro';
import Records from './Records.astro';
interface Props { locale: Locale; page: Section }
const { locale, page } = Astro.props;
const en = locale === 'en';
---
<div class="page-width subpage">
  <header class="page-title"><h1>{labels[locale][page]}</h1></header>
  {page === 'about' && <div class="prose">
    <p>{profile.biography[locale] || (en ? 'I’m Zhouchen. Welcome to my academic website.' : '你好，我是 Zhouchen，欢迎来到我的学术个人主页。')}</p>
    {profile.affiliation[locale] && <p>{profile.affiliation[locale]}</p>}
    <a href={href(locale, 'cv')}>{en ? 'Curriculum vitae' : '查看学术简历'}</a>
  </div>}
  {page === 'research' && <>
    <h2>{en ? 'Research interests' : '研究兴趣'}</h2>
    {profile.researchAreas.length ? <div class="record-list">{profile.researchAreas.map(area => <article class="record"><h3>{area.title[locale]}</h3><p>{area.description[locale]}</p></article>)}</div> : <p class="muted">{en ? 'Research interests will be added here.' : '研究方向待补充。'}</p>}
    <section class="home-section">
      <div class="section-heading"><h2>{en ? 'Related projects' : '相关项目'}</h2><a href={href(locale, 'projects')}>{en ? 'All projects' : '全部项目'}</a></div>
      <Records locale={locale} kind="projects" selected />
    </section>
  </>}
  {page === 'publications' && <Records locale={locale} kind="publications" />}
  {page === 'projects' && <Records locale={locale} kind="projects" />}
  {page === 'cv' && <>
    {profile.cvUrl && <p><a href={profile.cvUrl} download>{en ? 'Download CV (PDF)' : '下载简历（PDF）'}</a></p>}
    <Education locale={locale} />
    {profile.experience.length > 0 && <section class="home-section">
      <h2>{en ? 'Experience' : '工作与研究经历'}</h2>
      {profile.experience.map(item => <article class="timeline-row"><span>{item.period}</span><div><h3>{item.title[locale]}</h3><p>{item.institution[locale]}</p></div></article>)}
    </section>}
  </>}
  {page === 'contact' && <div class="prose">
    {profile.email && <p>Email: <a href={`mailto:${profile.email}`}>{profile.email}</a></p>}
    <p>GitHub: <a href={profile.github} target="_blank" rel="noopener noreferrer">NeverStoptoLearn</a></p>
  </div>}
</div>
